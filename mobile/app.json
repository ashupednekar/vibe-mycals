{
  "expo": {
    "name": "MyCals",
    "slug": "mycals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mycals",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b1210",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mycals.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "MyCals uses the camera to scan meals and nutrition labels.",
        "NSPhotoLibraryUsageDescription": "MyCals lets you scan a meal photo from your library."
      }
    },
    "android": {
      "package": "app.mycals.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#c6f26a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MyCals lets you scan a meal photo from your library.",
          "cameraPermission": "MyCals uses the camera to scan meals and nutrition labels."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MyCalsCalories",
              "label": "MyCals calories",
              "description": "Today's calories at a glance",
              "minWidth": "160dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8572622d-3c6f-42b7-a00e-7a2a30a137d5"
      }
    },
    "owner": "ashupednekardev"
  }
}
